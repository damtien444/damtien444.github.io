#!/bin/sh
# Stamp the site's "last updated" date into _data/last_updated.yml on every commit.
# Enabled via: git config core.hooksPath .githooks

set -e

repo_root=$(git rev-parse --show-toplevel)
stamp_file="$repo_root/_data/last_updated.yml"
today=$(date +%Y-%m-%d)

# Skip if the only staged change is the stamp file itself (avoids empty commits
# and pointless churn when re-committing on the same day).
staged=$(git diff --cached --name-only)
if [ "$staged" = "_data/last_updated.yml" ]; then
  exit 0
fi

mkdir -p "$repo_root/_data"
cat > "$stamp_file" <<EOF
# Generated by .githooks/pre-commit — do not edit by hand.
date: "$today"
EOF

git add "$stamp_file"
